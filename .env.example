# ===== Token Factory (Nebius) =====
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# ===== Tavily =====
TAVILY_API_KEY=

# ===== Research settings =====
# 2〜5 のループ（検索→要約→振り返り→新クエリ）を繰り返す回数
MAX_RESEARCH_LOOPS=3
# 1 回の検索で取得する結果数
TAVILY_MAX_RESULTS=3
# 検索結果の本文（raw_content）も取得するか
FETCH_FULL_PAGE=false

# ===== Email (レポートのメール送信) =====
# MAIL_TO を設定すると、調査終了後にレポートを自動送信（空なら送信しない）
# 複数宛先はカンマ区切り
MAIL_TO=
# Gmail の場合: SMTP_USER は Gmail アドレス、SMTP_PASSWORD は「アプリ パスワード」
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 送信元（空なら SMTP_USER）
MAIL_FROM=

# ===== Discord bot (uv run researcher-bot / bot.bat) =====
DISCORD_BOT_TOKEN=
# 実行を許可する Discord ユーザー ID（複数はカンマ区切り）
DISCORD_ALLOWED_USER_IDS=
# ボットを入れるサーバー ID（設定すると /research コマンドが即座に使えるようになる）
DISCORD_GUILD_ID=
